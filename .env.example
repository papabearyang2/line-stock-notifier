# LINE Developers Console > Messaging API
LINE_CHANNEL_SECRET=replace_me
LINE_CHANNEL_ACCESS_TOKEN=replace_me

# The public HTTPS origin used by LINE to download chart images.
# Example: https://your-service.onrender.com
PUBLIC_BASE_URL=https://example.com

# FinMind is the structured fallback when Goodinfo has no usable data.
FINMIND_TOKEN=

# Protects scheduled HTTP endpoints. Generate a long random value.
CRON_SECRET=

# Required for the private research website. Use separate long random values;
# do not reuse the LINE or cron secret.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=12

# Optional public object storage used for chart images in serverless environments.
BLOB_READ_WRITE_TOKEN=

# Goodinfo scraping is deliberately opt-in. Confirm the site's current terms
# and robots policy before enabling it.
GOODINFO_ENABLED=false
GOODINFO_MIN_INTERVAL_SECONDS=8
GOODINFO_CACHE_HOURS=24
GOODINFO_BROWSER_ENABLED=false
GOODINFO_BROWSER_EXECUTABLE=
GOODINFO_BROWSER_PROFILE_DIR=./data/goodinfo-browser-profile
GOODINFO_BACKFILL_ENABLED=false
# Keep false: the Web service never runs Goodinfo; manual scripts are the default.
GOODINFO_BACKFILL_SCHEDULED=false
GOODINFO_BACKFILL_SCOPE=research
GOODINFO_BACKFILL_INTERVAL_MINUTES=5
GOODINFO_BACKFILL_MAX_PAGES=30
GOODINFO_PILOT_STOCK_CODE=6274
GOODINFO_ROLLOUT_ENABLED=true

# Local default:
DATABASE_URL=sqlite:///./data/stockbot.db
# Some hosting integrations inject POSTGRES_URL instead.
POSTGRES_URL=
TIMEZONE=Asia/Taipei
ENABLE_SCHEDULER=true
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0
RESEARCH_REFRESH_HOUR=20
RESEARCH_REFRESH_MINUTE=0
NEWS_LOOKBACK_DAYS=3
ARTIFACT_DIR=./data/artifacts
LOG_LEVEL=INFO
